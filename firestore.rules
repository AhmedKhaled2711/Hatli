rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isParticipant(requestData) {
      return isSignedIn() && (
        request.auth.uid == requestData.requesterId ||
        request.auth.uid == requestData.runnerId
      );
    }

    // User profiles collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId);
      allow delete: if false;
    }

    // Requests marketplace collection
    match /requests/{requestId} {
      allow read: if isSignedIn();
      
      // Requesters can create requests under their own UID
      allow create: if isSignedIn() 
        && request.resource.data.requesterId == request.auth.uid
        && request.resource.data.status == 'Pending';

      // Updates are constrained by lifecycle transactions
      allow update: if isSignedIn() && (
        // Requester updating their request or confirming delivery / rating
        request.auth.uid == resource.data.requesterId ||
        // Runner accepting an unassigned pending request
        (resource.data.status == 'Pending' && resource.data.runnerId == null) ||
        // Assigned runner advancing task status
        request.auth.uid == resource.data.runnerId
      );

      allow delete: if false;

      // Chat sub-collection within a request
      match /messages/{messageId} {
        allow read: if isParticipant(get(/databases/$(database)/documents/requests/$(requestId)).data);
        allow create: if isParticipant(get(/databases/$(database)/documents/requests/$(requestId)).data)
          && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }
  }
}
