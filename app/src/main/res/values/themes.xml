<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light window theme. Dark is in values-night (framework has no Material.DayNight). -->
    <style name="Theme.Hatli" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/hatli_background</item>
        <item name="android:colorPrimary">@color/hatli_primary</item>
    </style>
</resources>
