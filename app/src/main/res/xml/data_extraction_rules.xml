<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude local Room database (cached user profiles) -->
        <exclude domain="database" path="." />
        <!-- Exclude session DataStore containing auth tokens and user session state -->
        <exclude domain="file" path="datastore" />
    </cloud-backup>
    <device-transfer>
        <!-- Exclude local Room database during device migration -->
        <exclude domain="database" path="." />
        <!-- Exclude session DataStore during device migration -->
        <exclude domain="file" path="datastore" />
    </device-transfer>
</data-extraction-rules>